							outpkg.write_uint32((*iter)->getEnergy());
std::cout<<"myId"<<(*iter)->myID<<"id"<<(*iter)->getID()<<"hp"<<(*iter)->getHP()<<"mp"<<(*iter)->getEnergy()<<std::endl;
